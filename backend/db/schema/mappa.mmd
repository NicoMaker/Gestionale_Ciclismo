    CESTINO {
        integer id PK
        text entita "squadre | corridori | tappe | nazioni | sponsor"
        integer entita_id "id originale della riga eliminata"
        text dati "snapshot JSON completo della riga, per il ripristino"
        datetime eliminato_il
        datetime scade_il "eliminato_il + 15 giorni: eliminazione definitiva automatica (cron notturno)"
    }

    NAZIONI {
        integer id PK
        text nome
        text codice_iso2 "usato per calcolare la bandiera lato frontend"
    }
    SQUADRE {
        integer id PK
        text nome
        integer nazione_id FK
        text colore
        datetime creato_il
    }
    CORRIDORI {
        integer id PK
        text nome
        text cognome
        integer numero_pettorale
        integer nazione_id FK
        integer squadra_id FK
        date data_nascita
        datetime creato_il
    }
    STAFF_TECNICO {
        integer id PK
        text nome
        text cognome
        text ruolo
        integer squadra_id FK
    }
    TAPPE {
        integer id PK
        integer numero_tappa
        text nome
        text partenza
        text arrivo
        real distanza_km
        integer dislivello_m
        text tipo
        date data
        text stato
    }
    TAPPE_PERCORSO {
        integer id PK
        integer tappa_id FK
        real km
        text tipo "sprint | gpm"
        text nome_luogo
        text categoria
    }
    RISULTATI {
        integer id PK
        integer tappa_id FK
        integer corridore_id FK
        integer posizione
        text tempo
        text distacco
        integer punti
    }
    CLASSIFICHE_TIPO {
        integer id PK
        text nome
        text descrizione
    }
    TRAGUARDI_VOLANTI {
        integer id PK
        integer tappa_id FK
        integer corridore_id FK
        integer posizione
        integer punti
    }
    GPM_RISULTATI {
        integer id PK
        integer tappa_id FK
        integer corridore_id FK
        integer posizione
        integer punti
    }
    PENALITA {
        integer id PK
        integer corridore_id FK
        integer tappa_id FK
        text motivo
        integer secondi
        integer punti
    }
    CONTROLLI_ANTIDOPING {
        integer id PK
        integer corridore_id FK
        integer tappa_id FK
        date data
        text esito
    }
    BICICLETTE {
        integer id PK
        integer corridore_id FK
        text marca
        text modello
        text telaio
    }
    SPONSOR {
        integer id PK
        text nome
        text settore
        text sito_web
    }
    SQUADRA_SPONSOR {
        integer id PK
        integer squadra_id FK
        integer sponsor_id FK
        text tipo
    }
    VEICOLI_SQUADRA {
        integer id PK
        integer squadra_id FK
        text tipo
        text targa
        text modello
    }
    HOTEL {
        integer id PK
        integer tappa_id FK
        integer squadra_id FK
        text nome
        text citta
        text indirizzo
    }
    METEO_TAPPA {
        integer id PK
        integer tappa_id FK
        real temperatura
        text condizione
        real vento_kmh
    }
    MEDIA_ACCREDITATI {
        integer id PK
        text nome
        text testata
        text tipo
        integer tappa_id FK
    }
    COMUNICATI_STAMPA {
        integer id PK
        text titolo
        text contenuto
        date data
        integer tappa_id FK
    }
